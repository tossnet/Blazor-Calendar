@page "/weeklyview"
@using BlazorCalendar
@using BlazorCalendar.Models
@using System.Globalization

<div class="scrollhor-toolbar mb-2" style="max-height: 35px;">
	<button type="button" @onclick="GoToday" class="btn">📅 Go Today</button>
	<WinOldButton OnClick="@(m => ClicMonthNavigate(-7))"
				  Appearance="Appearance.Win10"
				  Style="min-width: 27px;">▲</WinOldButton>
	<WinOldButton OnClick="@(m => ClicMonthNavigate(7))"
				  Appearance="Appearance.Win10"
				  Style="min-width: 27px;">▼</WinOldButton>

	<WinOldTextBox Appearance="Appearance.Win10"
				   Label="From :"
				   Value="@(today.ToString("yyyy-MM-dd"))"
				   InputStyle=" min-height: 24px;"
				   type="date"
				   Class="me-2"
				   @onchange="@(e => ChangeFirstDate(e.Value.ToString()))" />

	<WinOldSelect Appearance="Appearance.Win10"
				  T="BlazorCalendar.PriorityLabel"
				  @bind-Value="PriorityDisplay">
		<WinOldOption Value="PriorityLabel.Code">Label: Code</WinOldOption>
		<WinOldOption Value="PriorityLabel.Caption">Label: Caption</WinOldOption>
	</WinOldSelect>
	<div>
		<WinOldCheckBox Appearance="Appearance.Win10"
						Label="Draggable"
						@bind-Value="draggable" />
	</div>
	<div style="margin-left:8px">
		<WinOldCheckBox Appearance="Appearance.Win10"
						Label="Add Fake Hightlighted Days"
						@bind-Value="AddFakeHightlightedDays" />
	</div>
</div>

<section class="border rounded p-2 mb-2" aria-label="Time range selection demo">
    <label class="me-3">
        <input type="checkbox" @bind="EnableDemoRangeSelection" /> Select a time range
    </label>
    <button type="button" class="btn btn-primary btn-sm me-2" disabled="@(selectedRange is null)" @onclick="AddSelectedRange">Add demo event</button>
    <button type="button" class="btn btn-secondary btn-sm" disabled="@(demoTaskIds.Count == 0)" @onclick="ClearDemoEvents">Clear demo events</button>
    <p class="mb-1 mt-2">Drag on the time scale or empty grid within one day to select 15-minute slots, then click Add demo event. Disable range selection to drag existing tasks.</p>
    <p class="mb-0" role="status" aria-live="polite">@rangeStatus Demo events are stored only in memory; reloading the page removes them.</p>
</section>

<section class="border rounded p-2 mb-2" aria-label="Overlapping events demo">
    <label><input type="checkbox" @bind="ShowGridlineDemo" /> Show overlapping events to check hourly gridlines</label>
    <label class="ms-3"><input type="checkbox" @bind="UseHourScrolling" /> Scrollable hour viewport</label>
    <p class="mb-0">Adds three overlapping tasks on each day of the displayed week. Scroll above or below them: hourly lines continue across all task columns. Toggle off to restore the original fixtures.</p>
</section>

<CalendarContainer FirstDate="today"
				   TasksList="DisplayedTasks"
				   DisplayedView="DisplayedView.Weekly">
	<WeekView EnableHourScrolling="UseHourScrolling" VisibleStartHour="6" VisibleEndHour="17"
			  HeaderBackgroundColor="#d2e4f7" HeaderBorderColor="#9fb3c4"
			  EnableRangeSelection="@EnableDemoRangeSelection" RangeSelected="DemoRangeSelected"
			  WeekStartsOn="DayOfWeek.Monday" PriorityDisplay="@PriorityDisplay"
			  OutsideCurrentMonthClick="OutsideCurrentMonthClick"
			  TaskClick="TaskClick"
			  DayClick="DayClick"
			  Draggable="@(!EnableDemoRangeSelection && !ShowGridlineDemo && draggable)"
			  DragStart="DragStart"
			  DropTask="DropTask"
			  HighlightToday="true" TodayBackgroundColor="#f5f5f5" TodayBorderColor="#ff5b60"
			  HighlightedPeriods="@highlightedPeriods.ToArray()" />
</CalendarContainer>

<br />
<div class="console">@fakeConsole</div>

@code {
    private bool ShowGridlineDemo { get; set; }
    private bool UseHourScrolling { get; set; } = true;
    private Tasks[] DisplayedTasks => !ShowGridlineDemo ? TasksList.ToArray() :
        Enumerable.Range(0, 7).SelectMany(day => Enumerable.Range(0, 3).Select(column =>
        {
            var date = today.Date.AddDays(-((7 + (int)today.DayOfWeek - (int)DayOfWeek.Monday) % 7)).AddDays(day);
            return new Tasks { ID = 2000 + day * 3 + column, Code = $"Overlap {column + 1}",
                Caption = $"Overlap {column + 1}", DateStart = date.AddHours(7 + column),
                DateEnd = date.AddHours(13 + column), Color = "#cfe8ff", ForeColor = "#172b4d", NotBeDraggable = true };
        })).Concat(TasksList.Where(t => demoTaskIds.Contains(t.ID))).ToArray();
    private bool enableDemoRangeSelection = true;
    private TimeRangeSelectedParameter? selectedRange;
    private readonly HashSet<int> demoTaskIds = new();
    private int nextDemoTaskId = 1000;
    private string rangeStatus = "No time range selected.";
    private bool EnableDemoRangeSelection
    {
        get => enableDemoRangeSelection;
        set { enableDemoRangeSelection = value; ResetDemoRange(); }
    }

    private void DemoRangeSelected(TimeRangeSelectedParameter range)
    {
        if (!enableDemoRangeSelection || range.End <= range.Start || range.Start.Date != range.End.AddTicks(-1).Date) return;
        selectedRange = range;
        rangeStatus = $"Selected: {range.Start:yyyy-MM-dd HH:mm} – {range.End:HH:mm} ({(range.End-range.Start).TotalMinutes:0} minutes; end exclusive).";
    }

    private void AddSelectedRange()
    {
        if (selectedRange is not { } range) return;
        int id = nextDemoTaskId++;
        string title = $"DEMO {range.Start:HH:mm}–{range.End:HH:mm}";
        TasksList.Add(new Tasks { ID=id, Key=id.ToString(), Code=title, Caption=title,
            DateStart=range.Start, DateEnd=range.End, Color="#cfe8ff", ForeColor="#172b4d" });
        demoTaskIds.Add(id);
        selectedRange = null;
        rangeStatus = $"Added {title} on {range.Start:yyyy-MM-dd}. Demo events: {demoTaskIds.Count}.";
    }

    private void ClearDemoEvents()
    {
        TasksList.RemoveAll(t => demoTaskIds.Contains(t.ID));
        demoTaskIds.Clear();
        ResetDemoRange();
    }

    private void ResetDemoRange() { selectedRange = null; rangeStatus = "No time range selected."; }

	private DateTime today = DateTime.Today;
	private int months = 12;
	private List<Tasks> TasksList;
	private string fakeConsole = "";
	private BlazorCalendar.PriorityLabel PriorityDisplay = PriorityLabel.Code;
	private bool draggable = true;
	private bool addFakeHightlightedDays = false;

	private bool AddFakeHightlightedDays
	{
		get => addFakeHightlightedDays;
		set
		{
			addFakeHightlightedDays = value;
			highlightedPeriods = value ? fakeHighlightedPeriods : Array.Empty<HighlightedPeriod>();
		}
	}

	private HighlightedPeriod[] highlightedPeriods = Array.Empty<HighlightedPeriod>();

	private static readonly HighlightedPeriod[] fakeHighlightedPeriods = new[]
	{
		new HighlightedPeriod
		{
			DateStart = new DateTime(2026, 12, 25),
			RecurrenceType = RecurrenceType.Yearly,
			BackgroundColor = "#ff6565",
			Label = "Christmas",
			Icon = "🎄"
		},
		new HighlightedPeriod
		{
			DateStart = new DateTime(2026, 04, 14),
			RecurrenceType = RecurrenceType.Yearly,
			RecurrenceEndDate = new DateTime(2035, 12, 31),
			BackgroundColor = "#FFD700",
			Label = "Birthday",
			Icon = "🎂"
		},
		new HighlightedPeriod
		{
			DateStart = new DateTime(2026, 05, 01),
			DateEnd = new DateTime(2026, 05, 05),
			BackgroundColor = "#87CEEB",
			Label = "Holidays",
			Icon = "🧳"
		},
		new HighlightedPeriod
		{
			DateStart = new DateTime(2026, 01, 06),
			RecurrenceType = RecurrenceType.Weekly,
			BackgroundColor = "rgba(200, 200, 255, 0.3)",
			Label = "Team Meeting"
		},
		new HighlightedPeriod
		{
			DateStart = new DateTime(2026, 01, 25),
			RecurrenceType = RecurrenceType.Monthly,
			BackgroundColor = "#90EE90",
			Label = "Payday"
		}
	};

	protected override void OnInitialized()
	{
		//CultureInfo.DefaultThreadCurrentCulture = new CultureInfo("dz-DZ");
		//CultureInfo.DefaultThreadCurrentCulture = new CultureInfo("en-US");

		TasksList = new()
		{
			new Tasks { ID = 0, DateStart = today.AddDays(0), DateEnd = today.AddDays(1), Code = "HELLO", Color = "#FFD800", Caption = "Lorem ipsum dolor sit amet", FillStyle = FillStyleEnum.BackwardDiagonal },
			new Tasks { ID = 1, DateStart = today.AddDays(4).AddHours(8), DateEnd = today.AddDays(4).AddHours(11), Code = "😉 CP", Color = "#19C319", Caption = "Lorem ipsum dolor sit amet" } ,
			new Tasks { ID = 2, DateStart = today.AddDays(-2).AddHours(8), DateEnd = today.AddDays(-2).AddHours(20), Code = "POD", Color = "#844fe7", Caption = "Podcast DevApps", FillStyle = FillStyleEnum.ZigZag } ,
			new Tasks { ID = 3, DateStart = today.AddHours(5), DateEnd = today.AddHours(10), Code = "CALL", Color = "#eb3c37", ForeColor = "#222", Caption = "Lorem ipsum dolor sit amet", FillStyle=FillStyleEnum.CrossDots },
			new Tasks { ID = 4, DateStart = today.AddDays(31), DateEnd = today.AddDays(31), Code = "MTG", Color = "#19C319", Caption = "MTG:France" },
			new Tasks { ID = 5, DateStart = today.AddDays(40), DateEnd = today.AddDays(42), Code = "DEV", Color = "#FFD800", Comment="on Teams template", Caption = "Fusce quis purus eu ante" },
			new Tasks { ID = 6, DateStart = today.AddDays(32), DateEnd = today.AddDays(33), Code = "MEET", Color = "#0d6efd" },
			new Tasks { ID = 7, DateStart = today.AddDays(32), DateEnd = today.AddDays(32), Code = "BLAZOR", Color = "#FFC3FF", Caption = "Blazor Dev" } ,
			new Tasks { ID = 8, DateStart = today.AddDays(45).AddHours(8), DateEnd = today.AddDays(45).AddHours(9), Code = "MEETING", Color = "#2DD7D7", Comment="Julien's test" },
			new Tasks { ID = 9, DateStart = today.AddDays(-8), DateEnd = today.AddDays(-7), Code = "MEET⭐", Color = "#0d6efd",Caption = "MTG:France" }
		};
	}

	private void ChangeFirstDate(string value)
	{
		if (string.IsNullOrEmpty(value)) return;
		ResetDemoRange();
		today = DateTime.Parse(value.ToString());
	}

	private void GoToday()
	{
		ResetDemoRange();
		today = DateTime.Today;
	}

	private void ClicMonthNavigate(int daysToAdd)
	{
		ResetDemoRange();
		today = today.AddDays(daysToAdd);
	}

	private void OutsideCurrentMonthClick(int MonthAdded)
	{
		ResetDemoRange();
		today = today.AddMonths(MonthAdded);
	}

	private void TaskClick(ClickTaskParameter clickTaskParameter)
	{
		fakeConsole = "ID task(s) :" + string.Join(", ", clickTaskParameter.IDList);
	}

	private void DayClick(ClickEmptyDayParameter clickEmptyDayParameter)
	{
		fakeConsole = $"Empty day :{clickEmptyDayParameter.Day.ToShortDateString()}  {clickEmptyDayParameter.Day.ToShortTimeString()}";
	}

	private void DragStart(DragDropParameter dragDropParameter)
	{
		fakeConsole = $"DragStart event : {dragDropParameter.taskID}";
	}

	private void DropTask(DragDropParameter dragDropParameter)
	{
		fakeConsole = $"DropTask event :{dragDropParameter.Day.ToShortDateString()} {dragDropParameter.taskID}";

		Tasks taskDropped = TasksList.FirstOrDefault(t => t.ID == dragDropParameter.taskID);

		var TotalDay = (taskDropped.DateEnd - taskDropped.DateStart).TotalDays;
		taskDropped.DateEnd = dragDropParameter.Day.AddDays(TotalDay);
		taskDropped.DateStart = dragDropParameter.Day;
	}
}
